                <item name="bs_salestransfer_import" xsi:type="object">BS\SalesTransfer\Console\Command\ImportCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="BS\SalesTransfer\Model\Transfer\GridRefresher">
        <arguments>
