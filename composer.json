{
    "name": "bs/module-sales-transfer",
    "description": "Copy Magento orders, invoices, shipments and credit memos between installations without sending email, charging a payment or changing stock.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Bruna Sebold",
            "email": "sebold.bruna@gmail.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0.4",
        "magento/module-backend": "^102.0",
        "magento/module-sales": "^103.0",
        "magento/module-sales-sequence": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-customer": "^103.0",
        "magento/module-catalog": "^104.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BS\\SalesTransfer\\": ""
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "phpcs": "phpcs"
    }
}
